PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/database?retryWrites=true&w=majority
DNS_SERVERS=1.1.1.1,8.8.8.8
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com

JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash

FITROOM_API_KEY=your_fitroom_api_key
FITROOM_MOCK_MODE=false

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
